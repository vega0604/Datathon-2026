
﻿# Data and outputs
data/
# …but the frontend's data modules (imported by the UI) are source code.
!frontend/src/data/
# backend/data is re-opened so the runtime files below can be committed.
!backend/data/
outputs/
!outputs/charts/
!outputs/top500.csv

# Secrets and environment configs
.env
*.env.local

# Python caches
__pycache__/
*.py[cod]
venv/
.venv/
.ipynb_checkpoints/

# Python and uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Secrets
.env

# Data: never commit. Raw CSVs alone are ~850 MB and GitHub rejects files over 100 MB.
backend/data/*
!backend/data/.gitkeep
backend/src/backend/data/
*.parquet
*.csv
# ...except small files we want in the repo
!backend/src/backend/vendor_aliases.csv
!backend/outputs/top500.csv

# ...and the files the API reads at runtime (~100 MB), so a deploy needs no pipeline run.
# Raw CSVs, embeddings and the other intermediate files stay ignored.
!backend/data/app.duckdb
!backend/data/parquet/
backend/data/parquet/*
!backend/data/parquet/vulnerabilities.parquet
!backend/data/parquet/weakness_types.parquet
!backend/data/parquet/scoreboard_2026.parquet
!backend/data/clean/
backend/data/clean/*
!backend/data/clean/kev.parquet
!backend/data/clean/exploit_signals.parquet
!backend/data/clean/affected_products.parquet
!backend/data/clean/vendor_aliases.parquet
!backend/data/features/
backend/data/features/*
!backend/data/features/predictions.parquet
!backend/data/features/predictions_meta.json
!backend/data/features/insights.json

# Generated outputs: keep only the submission and charts
backend/outputs/*
!backend/outputs/.gitkeep
!backend/outputs/top500.csv
!backend/outputs/charts/
backend/outputs/charts/*.html

