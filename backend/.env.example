# Copy to .env (ignored by git) to override the defaults.

# Where the data lives. Only "duckdb" is implemented (Tiger Data arrives in SHE-10).
DATA_BACKEND=duckdb

# DuckDB file that stores uploaded SBOMs and their matches. Defaults to data/app.duckdb.
# APP_DB_PATH=

# SBOM queue. Scores come from data/features/predictions.parquet unless set.
# PREDICTIONS_PATH=
# Queue items whose scores are older than this many days are marked stale.
SCORE_STALE_DAYS=62
# Fetch today's EPSS from FIRST (api.first.org) for matched CVEs and re-score them.
EPSS_LIVE=false
# Let Granite on watsonx confirm description-only matches, at most MAX_MATCH_CHECKS per upload.
GRANITE_MATCH_CHECK=false
MAX_MATCH_CHECKS=25

# Let Granite rewrite the plain-words explanation of the top rows of each queue (cached).
GRANITE_EXPLANATIONS=false
GRANITE_EXPLAIN_TOP=10

# Insights pages: built by `uv run python -m backend.modeling.insights`.
# INSIGHTS_PATH=

# Push to Linear (Settings > API > Personal API keys). Never commit the real key.
LINEAR_API_KEY=
LINEAR_TEAM_KEY=SHE

# Header user until there is a login.
ME_NAME=Jane Doe
ME_ROLE=Security lead
ME_AVATAR_URL=

# Granite on watsonx (SHE-7). Use your own values; never commit .env.
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-4-h-small
# Stop a run once it has used this many watsonx tokens.
WATSONX_TOKEN_BUDGET=50000
# Local CPU embedding model, and the speed settings picked by the SHE-37 benchmark.
EMBEDDING_MODEL_ID=ibm-granite/granite-embedding-small-english-r2
EMBEDDING_MAX_SEQ_LENGTH=256
# torch, onnx or openvino
EMBEDDING_BACKEND=openvino
EMBEDDING_BATCH_SIZE=32
